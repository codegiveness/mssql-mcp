<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\mssql-mcp.Tools\mssql-mcp.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>mssql_mcp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <VersionPrefix>0.5.3</VersionPrefix>
    <PackAsTool>true</PackAsTool>
    <PackageId>codegiveness.mssql-mcp</PackageId>
    <Authors>codegiveness</Authors>
    <Copyright>Copyright (c) 2026 codegiveness</Copyright>
    <Description>A Model Context Protocol (MCP) server for Microsoft SQL Server, built in C#/.NET 10. Lets AI agents (Claude Desktop, Cursor, etc.) safely query and interact with SQL Server databases through a controlled tool surface.</Description>
    <PackageTags>mcp;mcp-server;model-context-protocol;sql-server;mssql;database;ai-agent;claude;cursor</PackageTags>
    <PackageProjectUrl>https://github.com/codegiveness/mssql-mcp</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/codegiveness/mssql-mcp/releases</PackageReleaseNotes>
    <ToolCommandName>mssql-mcp</ToolCommandName>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/codegiveness/mssql-mcp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryCommit>$(SourceRevisionId)</RepositoryCommit>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

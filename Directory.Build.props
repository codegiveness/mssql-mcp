<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Distro SDK library-packs may repackage NuGet artifacts with different hashes. -->
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1707: 590 hits — idiomatic xUnit test naming + namespace matches package name. Permanent suppression. -->
    <!-- CA1848: LoggerMessage migration is deferred independently of release major. -->
    <!-- CA1873: Expensive logging argument evaluation remains a tracked cleanup. -->
    <!-- CA1863: CompositeFormat caching remains a tracked cleanup. -->
    <!-- CA1861: Constant test argument arrays remain a tracked cleanup. -->
    <!-- CA1859: Concrete test helper types remain a tracked cleanup. -->
    <NoWarn>$(NoWarn);CA1707;CA1848;CA1873;CA1863;CA1861;CA1859</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Framework-dependent/tool packages also copy native SNI unless its assets are excluded. -->
    <PackageReference Include="Microsoft.Data.SqlClient.SNI.runtime" ExcludeAssets="all" PrivateAssets="all" />
    <RuntimeHostConfigurationOption Include="Switch.Microsoft.Data.SqlClient.UseManagedNetworkingOnWindows" Value="true" />
  </ItemGroup>
</Project>

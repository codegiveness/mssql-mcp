*.swp
*~

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml

# npm
# npm/bin/mssql-mcp.js is the permanent entry point (not overwritten at install time).
# The binary arrives via npm's optionalDependencies — see ADR-0028.
npm/node_modules/
/.config/npm-tools/node_modules/
/.config/npm-cli/node_modules/
scripts/__pycache__/
npm/bin/mssql-mcp.exe
npm/*.tgz

# Publish output
publish/
artifacts/

# Logs
*.log

# OS
Thumbs.db
Desktop.ini

# Local env files
.env
.env.local

# Azure SQL Edge (integration test data)
azure-sql-edge-data/

# Agent / AI tooling — local-only scratch, caches, and session state.
# These are per-developer working artifacts (issue drafts, ticket specs,
# knowledge-graph DBs, run continuations, skill caches) and must never be
# committed. .codegraph/ ships its own .gitignore that ignores everything
# except itself; the line here is a belt-and-suspenders fallback in case
# that file is ever removed.
.scratch/
.codegraph/
.omo/
.opencode/
.opencode.json
.opencode.jsonc
opencode.json
opencode.jsonc
# omp project directory: maintainer-local workflow (.omp/AGENTS.md) and MCP
# client config that can hold connection strings. Never commit.
.omp/

# Git worktrees (local-only isolated checkouts created by the
# using-git-worktrees skill). Never commit worktree contents.
.worktrees/

# Other AI coding assistants' private state. The shared instruction files
# AGENTS.md (all agents) and CLAUDE.md (Claude Code) are project source and
# are tracked; personal or machine-specific instructions go in .omp/AGENTS.md
# or the assistant's own ignored directory below.
.claude/
CLAUDE.local.md
.mcp.json
.cursor/
.cursorrules
.aider*
.codex*
.continue/
.windsurf/
codeium*
.tabnine*

# Local SQLite databases (AI tooling artifacts, never commit)
umans-gate*
*.db
*.db-shm
*.db-wal
